# Настройки сайта на VPS. Скопировать в /etc/taraplus/env (см. README.md),
# заполнить и закрыть от посторонних: sudo chmod 600 /etc/taraplus/env
# Пароли и ключи сюда вписываете только вы, в git этот файл не попадает.

# Сервер слушает только локальный адрес, наружу его отдаёт nginx.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Папка с данными (аккаунты, заявки, статистика) - вне папки проекта,
# чтобы обновление сайта её не трогало.
DATA_DIR=/var/lib/taraplus

# Почта администратора (через запятую, если несколько) - доступ к админке.
ADMIN_EMAILS=

# Ключ подписи капчи «Я не робот» - любая длинная случайная строка
# (сгенерировать: openssl rand -hex 32). Без него ключ меняется при каждом
# перезапуске, это тоже работает.
CAPTCHA_SECRET=

# Дополнительные запрещённые почтовые домены (через запятую), необязательно.
BLOCKED_EMAIL_DOMAINS=

# ---- Почта (пока не заполнено - письма не уходят, коды пишутся в журнал) ----
# Unisender Go: ключ и адрес API из личного кабинета, отправитель на вашем домене.
UNISENDER_GO_API_KEY=
UNISENDER_GO_URL=https://go1.unisender.ru/ru/transactional/api/v1
MAIL_FROM=
MAIL_FROM_NAME=Тара+
SUPPORT_EMAIL=
MAIL_SKIP_UNSUBSCRIBE=
# Суточный лимит писем почтового сервиса (по умолчанию 100): коды
# подтверждения - не больше 80% от него, остальное - письма в поддержку.
MAIL_DAY_LIMIT=100

# ---- Оплата: Робокасса (пока логин и пароли не заданы - оплаты нет) ----
# Из технических настроек магазина в кабинете Робокассы. Пароли вписывать
# только на сервере, никому не пересылать.
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
# 1 - тестовый режим (тестовые пароли, деньги не списываются); пусто - боевой.
ROBOKASSA_TEST=1
# Алгоритм хеша, как в настройках магазина: sha256 (по умолчанию), md5, sha1, sha384, sha512.
ROBOKASSA_HASH=sha256

# Почта поддержки в админке: чтение ящика на Яндексе (IMAP) и ответы с него
# (SMTP Яндекса).
# Адрес ящика целиком и пароль приложения Яндекса (не основной пароль).
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASSWORD=
